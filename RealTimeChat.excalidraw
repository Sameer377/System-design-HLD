      "updated": 1792061077883,
      "created": 1792056526880,
      "link": null,
      "locked": false,
      "text": "A single server can manage ~50k conccurent websocket \nconenctions but with headroom lets consider 25k connections\nso we need 100k/25k = 4 servers ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single server can manage ~50k conccurent websocket \nconenctions but with headroom lets consider 25k connections\nso we need 100k/25k = 4 servers ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

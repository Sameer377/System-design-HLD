      "version": 444,
      "versionNonce": 1984316571,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792061073095,
      "created": 1792056748614,
      "link": null,
      "locked": false,
      "text": "A single DB node can handle 1 to 5TB \nso we might need sharding if the storge limit is exceeding \nwe can use consistent hashing to destribute\ndata with user_id hashKey",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single DB node can handle 1 to 5TB \nso we might need sharding if the storge limit is exceeding \nwe can use consistent hashing to destribute\ndata with user_id hashKey",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

    {
      "id": "yr6LH3lCpd3tWT1ifuqZs",
      "type": "text",
      "x": -151.24774630572023,
      "y": 3265.430639022922,
      "width": 556.1195678710938,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2l",
      "roundness": null,
      "seed": 131940059,
      "version": 883,
      "versionNonce": 1758135157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792061531892,
      "created": 1792060501512,
      "link": null,
      "locked": false,
      "text": "server A will check into redis cache for \nclient B's server channel (channel_B)\nthen Server A publish event to channel_B\nserver B has subscribed to channel_B so it \nwill consume it in real time \nthen server B will look into its connection list \nif there is active connection for client B and if its there\nthen forward msg to that connection and if its not \nthen publish notification event to redis stream  ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "server A will check into redis cache for \nclient B's server channel (channel_B)\nthen Server A publish event to channel_B\nserver B has subscribed to channel_B so it \nwill consume it in real time \nthen server B will look into its connection list \nif there is active connection for client B and if its there\nthen forward msg to that connection and if its not \nthen publish notification event to redis stream  ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

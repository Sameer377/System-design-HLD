  "elements": [
    {
      "id": "2Eu2-kjid9e_qHk_daNed",
      "type": "text",
      "x": -734.411093818352,
      "y": 3860.0259464022442,
      "width": 286,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",

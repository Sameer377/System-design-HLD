yle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 2640440600, "version": 1, "versionNonce": 1303511450, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 5, "text": "Retry with backoff\nthen Dead-letter Queue", "textAlign": "center", "verticalAlign": "middle", "containerId": "5d6d0e7b5198413c", "originalText": "Retry with backoff\nthen Dead-letter Queue", "autoResize": false, "lineHeight": 1.25, "baseline": 17}, {"id": "06e376ee3b0c452b", "type": "arrow", "x": 1545, "y": 445, "width": 0, "height": 55, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": {"type": 2}, "seed": 1469270996, "version": 1, "versionNonce": 2572176895, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [0, 55]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "093f9624106742ef", "type": "text", "x": 1550, "y": 455, "width": 180, "height": 28, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 1578869439, "version": 1, "versionNonce": 882341765, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 15, "fontFamily": 5, "text": "failed delivery", "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "failed delivery", "autoResize": true, "lineHeight": 1.25, "baseline": 15}, {"id": "c4b9767c43b8489d", "type": "text", "x": 1760, "y": 690, "width": 390, "height": 45, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 3238068833, "version": 1, "versionNonce": 2018078195, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 5, "text": "Workers check current user preferences\nbefore sending", "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Workers check current user preferences\nbefore sending", "autoResize": true, "lineHeight": 1.25, "baseline": 16}, {"id": "22c88ea0809a4387", "type": "text", "x": 60, "y": 930, "width": 1000, "height": 35, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 1751302721, "version": 1, "versionNonce": 3545259425, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 5, "text": "REQUEST FLOW", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REQUEST FLOW", "autoResize": true, "lineHeight": 1.25, "baseline": 22}, {"id": "6a0d65fac6d841e1", "type": "text", "x": 60, "y": 970, "width": 1000, "height": 170, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 3554808899, "version": 1, "versionNonce": 2453785679, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 5, "text": "1. Authenticate, validate payload and apply rate limits.\n2. Require an idempotency key to prevent duplicate API submissions.\n3. Persist notification + outbox event atomically; return 202 only after durable acceptance.\n4. Outbox publisher sends events to Kafka; use separate critical and bulk topics.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. Authenticate, validate payload and apply rate limits.\n2. Require an idempotency key to prevent duplicate API submissions.\n3. Persist notification + outbox event atomically; return 202 only after durable acceptance.\n4. Outbox publisher sends events to Kafka; use separate critical and bulk topics.", "autoResize": true, "lineHeight": 1.25, "baseline": 18}, {"id": "c834311070234a88", "type": "text", "x": 1120, "y": 930, "width": 1000, "height": 35, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 2363221247, "version": 1, "versionNonce": 3836081513, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 5, "text": "DELIVERY + FAILURE HANDLING", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DELIVERY + FAILURE HANDLING", "autoResize": true, "lineHeight": 1.25, "baseline": 22}, {"id": "5d9196ad4fb54fd1", "type": "text", "x": 1120, "y": 970, "width": 1000, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 4273060044, "version": 1, "versionNonce": 1288359002, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 5, "text": "5. Independent channel workers scale horizontally; reserve capacity for OTP traffic.\n6. Check preferences, render the channel template, then call the provider.\n7. Retry transient errors with exponential backoff + jitter; send exhausted events to DLQ.\n8. Update status from provider responses/webhooks; deduplicate callbacks and status updates.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5. Independent channel workers scale horizontally; reserve capacity for OTP traffic.\n6. Check preferences, render the channel template, then call the provider.\n7. Retry transient errors with exponential backoff + jitter; send exhausted events to DLQ.\n8. Update status from provider responses/webhooks; deduplicate callbacks and status updates.", "autoResize": true, "lineHeight": 1.25, "baseline": 18}, {"id": "682db48c5e5c4323", "type": "text", "x": 60, "y": 1190, "width": 2050, "height": 90, "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 3517443591, "version": 1, "versionNonce": 2678931757, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 5, "text": "IMPORTANT TRADE-OFFS: Kafka is at-least-once in typical setups, so consumers must be idempotent. Do not promise exactly-once SMS/email delivery. Use provider idempotency where supported. Start with one replicated MongoDB deployment; shard only when measured capacity requires it.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "IMPORTANT TRADE-OFFS: Kafka is at-least-once in typical setups, so consumers must be idempotent. Do not promise exactly-once SMS/email delivery. Use provider idempotency where supported. Start with one replicated MongoDB deployment; shard only when measured capacity requires it.", "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"id": "6e90972853434630", "type": "text", "x": 60, "y": 1310, "width": 2050, "height": 55, "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 3269685001, "version": 1, "versionNonce": 794860823, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 5, "text": "SCALE NOTE: 10M/day ≈ 116/sec average. 10K/sec bursts drive worker/Kafka capacity planning; estimate payload bandwidth from message size and include replication/protocol overhead.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SCALE NOTE: 10M/day ≈ 116/sec average. 10K/sec bursts drive worker/Kafka capacity planning; estimate payload bandwidth from message size and include replication/protocol overhead.", "autoResize": true, "lineHeight": 1.25, "baseline": 17}], "appState": {"gridSize": 20, "viewBackgroundColor": "#ffffff", "currentItemStrokeColor": "#1e1e1e", "currentItemBackgroundColor": "transparent", "currentItemFillStyle": "solid", "currentItemStrokeWidth": 2, "currentItemStrokeStyle": "solid", "currentItemRoughness": 0, "currentItemOpacity": 100, "currentItemFontFamily": 5, "currentItemFontSize": 20, "currentItemTextAlign": "left", "currentItemStartArrowhead": null, "currentItemEndArrowhead": "arrow", "scrollX": 0, "scrollY": 0, "zoom": {"value": 0.75}, "theme": "light"}, "files": {}}
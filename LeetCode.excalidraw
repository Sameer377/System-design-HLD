      "link": null,
      "locked": false,
      "text": "select \n    u.name as Name, l.score as Score\nfrom \n    User as u join LeaderBoard as l \non l.user_id=u.user_id\nwhere l.competition_id=?\norder by \n    problems_solved DESC, \n    score DESC, \n    total_panelty as ASC;  ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "select \n    u.name as Name, l.score as Score\nfrom \n    User as u join LeaderBoard as l \non l.user_id=u.user_id\nwhere l.competition_id=?\norder by \n    problems_solved DESC, \n    score DESC, \n    total_panelty as ASC;  ",

      "updated": 1791365106110,
      "created": 1791365085682,
      "link": null,
      "locked": false,
      "text": "Lets scale it to 100M DAU \n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets scale it to 100M DAU \n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dijHwG8dfxVDws1pLZg3T",
      "type": "text",
      "x": -691.1720937219177,
      "y": 2833.3569843520686,
      "width": 1230.3097709815052,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1d",
      "roundness": null,
      "seed": 91980868,
      "version": 830,
      "versionNonce": 208181828,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791366609064,
      "created": 1791365121750,
      "link": null,
      "locked": false,
      "text": "Scale (assume): \n100M new URLs/month ≈ 40 writes/s; \nread:write 100:1 ≈ 4K reads/s avg, \n~10K peak; \n~500 B/record × 6B records (5 yrs) ≈ 3 TB ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scale (assume): \n100M new URLs/month ≈ 40 writes/s; \nread:write 100:1 ≈ 4K reads/s avg, \n~10K peak; \n~500 B/record × 6B records (5 yrs) ≈ 3 TB ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
